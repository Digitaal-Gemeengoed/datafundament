# Caddy op dfc: TLS (Let's Encrypt) en de enige ingang (DF-ADR-009).
# Alles logt in via Keycloak (DF-ADR-012): het portaal, Trino en OpenMetadata zelf,
# Dagster en de catalogus via de poort (DF-ADR-018).
# Namen: {$DOMEIN} en *.{$DOMEIN} wijzen naar dfc.

# De poort (DF-ADR-018): wie hier binnenkomt, is via Keycloak ingelogd (met tweede
# factor) en heeft in het portaal het recht platform.bedienen. oauth2-proxy beslist;
# niet ingelogd gaat naar Keycloak, ingelogd zonder recht krijgt 403.
# Gebruik: import poort <onderdeel:poort>
(poort) {
	header {
		X-Robots-Tag "noindex, nofollow"
		Referrer-Policy no-referrer
		X-Content-Type-Options nosniff
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	handle /oauth2/* {
		reverse_proxy poort:4180 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Uri {uri}
		}
	}
	handle {
		forward_auth poort:4180 {
			uri /oauth2/auth
			header_up X-Real-IP {remote_host}
			copy_headers X-Auth-Request-Email
			@uit status 401
			handle_response @uit {
				redir * /oauth2/start?rd={scheme}://{host}{uri}
			}
		}
		reverse_proxy {args[0]}
	}
}

# Startpagina: alleen links naar de onderdelen, zonder inlog.
{$DOMEIN} {
	header X-Robots-Tag "noindex, nofollow"
	header -Server
	root * /srv/start
	file_server
}

# Dagster: de keten, runs, lineage.
dagster.{$DOMEIN} {
	import poort dagster-webserver:3000
}

# Trino: de voordeur voor afnemers (JDBC, CLI, web-UI). Trino logt zelf in via
# Keycloak (DF-ADR-017); geen wachtwoord van Caddy ervoor.
trino.{$DOMEIN} {
	header -Server
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy trino:8080
}

# Lakekeeper: de Iceberg-catalogus, met web-UI op /ui.
catalogus.{$DOMEIN} {
	import poort lakekeeper:8181
}

# Het portaal: eigen inlog via Keycloak (met tweede factor) en een noodaccount.
# Geen wachtwoord van Caddy ervoor; het portaal zet zelf zijn beveiligingskoppen.
admin.{$DOMEIN} {
	header -Server
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy portaal:4300
}

# OpenMetadata: de catalogus (DF-ADR-007). Eigen inlog via Keycloak; geen
# wachtwoord van Caddy ervoor, dat zou de terugkeer van Keycloak blokkeren.
metadata.{$DOMEIN} {
	header -Server
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy openmetadata:8585
}

# Keycloak: alleen het inloggen. Het beheerscherm is van buiten dicht (SSH-tunnel).
id.{$DOMEIN} {
	header -Server
	header Strict-Transport-Security "max-age=31536000"
	@beheer path /admin /admin/*
	respond @beheer 404
	reverse_proxy keycloak:8080
}
