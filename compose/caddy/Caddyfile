# Caddy op dfc: TLS (Let's Encrypt) en de enige ingang (DF-ADR-009).
# Zolang het een PoC is, vraagt elke naam hetzelfde wachtwoord. Keycloak volgt (DF-ADR-012).
# Namen: {$DOMEIN} en *.{$DOMEIN} wijzen naar dfc.

(afgeschermd) {
	basic_auth {
		{$WEB_GEBRUIKER} {$WEB_WACHTWOORD_HASH}
	}
	header {
		X-Robots-Tag "noindex, nofollow"
		Referrer-Policy no-referrer
		X-Content-Type-Options nosniff
		-Server
	}
}

# Startpagina, met links naar de onderdelen.
{$DOMEIN} {
	import afgeschermd
	root * /srv/start
	file_server
}

# Dagster: de keten, runs, lineage.
dagster.{$DOMEIN} {
	import afgeschermd
	reverse_proxy dagster-webserver:3000
}

# Trino: de voordeur voor afnemers (JDBC, CLI, web-UI). Het wachtwoord van Caddy
# is ook het wachtwoord voor JDBC; Caddy stuurt het niet door naar Trino.
trino.{$DOMEIN} {
	import afgeschermd
	reverse_proxy trino:8080 {
		header_up -Authorization
	}
}

# Lakekeeper: de Iceberg-catalogus, met web-UI op /ui.
catalogus.{$DOMEIN} {
	import afgeschermd
	reverse_proxy lakekeeper:8181 {
		header_up -Authorization
	}
}
