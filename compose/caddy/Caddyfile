# Caddy op dfc: TLS (Let's Encrypt) en de enige ingang (DF-ADR-009).
# De onderdelen vragen nog hetzelfde wachtwoord; het portaal logt in via Keycloak (DF-ADR-012).
# Namen: {$DOMEIN} en *.{$DOMEIN} wijzen naar dfc.

(afgeschermd) {
	basic_auth {
		{$WEB_GEBRUIKER} {$WEB_WACHTWOORD_HASH}
	}
	header {
		X-Robots-Tag "noindex, nofollow"
		Referrer-Policy no-referrer
		X-Content-Type-Options nosniff
		-Server
	}
}

# Startpagina, met links naar de onderdelen.
{$DOMEIN} {
	import afgeschermd
	root * /srv/start
	file_server
}

# Dagster: de keten, runs, lineage.
dagster.{$DOMEIN} {
	import afgeschermd
	reverse_proxy dagster-webserver:3000
}

# Trino: de voordeur voor afnemers (JDBC, CLI, web-UI). Het wachtwoord van Caddy
# is ook het wachtwoord voor JDBC; Caddy stuurt het niet door naar Trino.
trino.{$DOMEIN} {
	import afgeschermd
	reverse_proxy trino:8080 {
		header_up -Authorization
	}
}

# Lakekeeper: de Iceberg-catalogus, met web-UI op /ui.
catalogus.{$DOMEIN} {
	import afgeschermd
	reverse_proxy lakekeeper:8181 {
		header_up -Authorization
	}
}

# Het portaal: eigen inlog via Keycloak (met tweede factor) en een noodaccount.
# Geen wachtwoord van Caddy ervoor; het portaal zet zelf zijn beveiligingskoppen.
admin.{$DOMEIN} {
	header -Server
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy portaal:4300
}

# OpenMetadata: de catalogus (DF-ADR-007). Eigen inlog via Keycloak; geen
# wachtwoord van Caddy ervoor, dat zou de terugkeer van Keycloak blokkeren.
metadata.{$DOMEIN} {
	header -Server
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy openmetadata:8585
}

# Keycloak: alleen het inloggen. Het beheerscherm is van buiten dicht (SSH-tunnel).
id.{$DOMEIN} {
	header -Server
	header Strict-Transport-Security "max-age=31536000"
	@beheer path /admin /admin/*
	respond @beheer 404
	reverse_proxy keycloak:8080
}
